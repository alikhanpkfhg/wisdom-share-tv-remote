<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:text="Offline" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="14dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECT TO TV"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:letterSpacing="0.1" />

            <Button
                android:id="@+id/scanBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_key"
                android:textColor="@color/text"
                android:text="Scan for TVs (_share._tcp)" />

            <ListView
                android:id="@+id/deviceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/ipInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_panel"
                android:padding="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:inputType="text"
                android:hint="TV IP, e.g. 192.168.1.23" />

            <EditText
                android:id="@+id/portInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_panel"
                android:padding="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:inputType="number"
                android:hint="Port (filled from scan; optional)" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_key_primary"
                android:textColor="#04121F"
                android:textStyle="bold"
                android:text="Connect" />

            <Button
                android:id="@+id/disconnectBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_key"
                android:textColor="@color/danger"
                android:text="Disconnect" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:text="Phone and TV must share the same Wi-Fi. Scanning uses the TV's mDNS advertisement, exactly like the official app." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/remotePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/powerBtn"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="⏻" />

                <Button
                    android:id="@+id/inputBtn"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Input" />

                <Button
                    android:id="@+id/keyMenu"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Menu" />
            </LinearLayout>

            <android.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="3"
                android:rowCount="3">

                <Button
                    android:id="@+id/keyUp"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_column="1"
                    android:layout_row="0"
                    android:layout_gravity="fill"
                    android:layout_columnWeight="1"
                    android:text="▲" />

                <Button
                    android:id="@+id/keyLeft"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_column="0"
                    android:layout_row="1"
                    android:layout_gravity="fill"
                    android:layout_columnWeight="1"
                    android:text="◀" />

                <Button
                    android:id="@+id/keyOk"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_column="1"
                    android:layout_row="1"
                    android:layout_gravity="fill"
                    android:layout_columnWeight="1"
                    android:background="@drawable/bg_key_primary"
                    android:textColor="#04121F"
                    android:textStyle="bold"
                    android:minHeight="72dp"
                    android:text="OK" />

                <Button
                    android:id="@+id/keyRight"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_column="2"
                    android:layout_row="1"
                    android:layout_gravity="fill"
                    android:layout_columnWeight="1"
                    android:text="▶" />

                <Button
                    android:id="@+id/keyDown"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_column="1"
                    android:layout_row="2"
                    android:layout_gravity="fill"
                    android:layout_columnWeight="1"
                    android:text="▼" />
            </android.widget.GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/keyBack"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Back" />

                <Button
                    android:id="@+id/keyHome"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Home" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/volDown"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Vol −" />

                <Button
                    android:id="@+id/volMute"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Mute ~" />

                <Button
                    android:id="@+id/volUp"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Vol +" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/playBtn"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Play ~" />

                <Button
                    android:id="@+id/pauseBtn"
                    style="@style/RemoteKey"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Pause ~" />
            </LinearLayout>

            <EditText
                android:id="@+id/kbdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_panel"
                android:padding="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:inputType="text"
                android:maxLength="500"
                android:hint="Type to enter on the TV (KEYBOARD_INPUT_EVENT)" />

            <Button
                android:id="@+id/kbdSend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_key"
                android:textColor="@color/text"
                android:text="Send text" />

            <TextView
                android:id="@+id/lastResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Last TV response: —" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:text="@string/exp_hint" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>